# Direct Postgres connection string
# Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.example.supabase.co:5432/postgres?sslmode=require

# Shared secret — must exactly match RUST_API_SECRET in the Next.js .env.
# Required, and must be at least 16 characters; the server panics on startup
# otherwise. Generate one with: openssl rand -hex 32
API_SECRET=replace-with-a-random-32-char-string

# Server port (default 3001)
PORT=3001

# Log level (default "vasudha_api=debug,tower_http=info")
# RUST_LOG=vasudha_api=debug,tower_http=info