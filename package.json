    "test:smoke": "node scripts/test-smoke.mjs",
    "clerk:jwt": "node --env-file=.env scripts/setup-clerk-jwt.mjs",
    "seed": "node --env-file=.env seed.mjs",
    "api": "cargo run --manifest-path backend/Cargo.toml",
    "db:reset": "supabase db reset",
