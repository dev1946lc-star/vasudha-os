# Supabase
# In local development, NEXT_PUBLIC_SUPABASE_URL points to scripts/supabase-proxy.mjs (:54321)
# or local PostgREST/Docker. In production/hosted environments, use your Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Secret Keys (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Rust Microservice & Direct Database Connection
RUST_API_URL=http://localhost:3001
RUST_API_SECRET=your-rust-api-secret-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
API_SECRET=your-rust-api-secret-key