# Public/Publishable Keys (Safe for frontend)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Secret Keys (Backend only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase JWT secret — used only by scripts/setup-clerk-jwt.mjs to provision
# the Clerk "supabase" JWT template. NOT the anon key. Find it under
# Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Clerk Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Rust API. RUST_API_SECRET must exactly match API_SECRET in backend/.env.
# The backend refuses to start if it is unset or shorter than 16 characters.
RUST_API_URL=http://localhost:3001
RUST_API_SECRET=replace-with-a-random-32-char-string